@@ -0,0 +1,20 @@
+import React from 'react';
+import { buildRenderCursorAtPositionSequence } from '../cursor-helpers.js';
+const shapeToCode = {
+    blockBlink: 1,
+    block: 2,
+    underscoreBlink: 3,
+    underscore: 4,
+    pipeBlink: 5,
+    pipe: 6,
+
+}
+export default function Cursor({ shape = 'block' }) {
+    const code = shapeToCode[shape];
+    if (code == null) {
+        throw new Error(`No such cursor shape ${shape}`);
+    }
+    const content = buildRenderCursorAtPositionSequence(code);
+    globalThis.lastContent = content;
+    return (React.createElement("ink-text", { style: { flexGrow: 0, flexShrink: 1, flexDirection: 'row', textWrap: 'wrap' } }, content));
+}
